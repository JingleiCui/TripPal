# Copy to .env.server; choose independent secrets; URL-encode password in both URLs.
MYSQL_DATABASE=travel_agent
MYSQL_USER=travel
MYSQL_PASSWORD=REPLACE_WITH_INDEPENDENT_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_ROOT_PASSWORD
TRAVEL_DATABASE_URL=mysql+pymysql://travel:URL_ENCODED_PASSWORD@mysql:3306/travel_agent?charset=utf8mb4
TRAVEL_CHECKPOINT_URL=mysql://travel:URL_ENCODED_PASSWORD@mysql:3306/travel_agent
TRAVEL_MODEL_PROVIDER=gemini
TRAVEL_MODEL_NAME=gemini-3.8-flash
TRAVEL_MODEL_API_KEY=
TRAVEL_MODEL_ENABLED=false
TRAVEL_AMAP_KEY=
TRAVEL_AMAP_JS_KEY=
TRAVEL_AMAP_SECURITY_CODE=
# Server must download trusted model weights on first indexing or mount preloaded cache.
TRAVEL_EMBEDDING_LOCAL_ONLY=false

# Production account lifecycle; configure a real HTTPS origin and your own SMTP.
TRAVEL_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TRAVEL_EMAIL_REQUIRED=true
TRAVEL_PUBLIC_BASE_URL=https://travel.example.com
TRAVEL_SMTP_HOST=
TRAVEL_SMTP_PORT=587
TRAVEL_SMTP_STARTTLS=true
TRAVEL_SMTP_ALLOW_EXTERNAL=true
TRAVEL_SMTP_USER=
TRAVEL_SMTP_PASSWORD=
TRAVEL_MAIL_FROM=travel_agent <no-reply@example.com>
# Optional analytics remains off without both explicit consent and a write key.
TRAVEL_POSTHOG_KEY=
